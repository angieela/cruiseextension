{ 
    "manifest_version": 3,
    "name": "Royal Caribbean Cruise Price Tracker",
    "version": "1.0", 
    "description": "Adds cruise price-history ratings to Royal Caribbean listings.",
    "host_permissions": [
        "https://www.royalcaribbean.com/*",
        "https://royalcaribbean.com/*",
        "http://127.0.0.1:8000/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://www.royalcaribbean.com/*",
                "https://royalcaribbean.com/*"
            ],
            "js": ["content.js"]
        }
    ]
}
