# Optional: the application defaults to sqlite:///./cruises.db when this is unset.
DATABASE_URL=sqlite:///./cruises.db

# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/cruise_extension

# Future scheduled-scrape failure email configuration. These are documented
# placeholders only; no email provider is connected yet.
# SCRAPER_ALERT_EMAIL_TO=you@example.com
# SCRAPER_ALERT_EMAIL_FROM=alerts@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls
